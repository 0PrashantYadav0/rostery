{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rostery",
  "version": "0.1.0",
  "identifier": "dev.rostery.app",
  "build": {
    "frontendDist": "../dist/app",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Rostery",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Get roasted by an AI that read your Spotify and YouTube history.",
    "longDescription": "Rostery reads your Spotify and YouTube history on your own computer, draws it as a universe of planets, and has an AI write you a roast you can share.",
    "copyright": "Copyright 2026 Prashant Kumar Yadav",
    "license": "MIT",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
