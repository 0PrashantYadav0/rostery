{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window: listening for app events, the file picker, and opening Source links",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://open.spotify.com/*"
        },
        {
          "url": "https://www.youtube.com/*"
        }
      ]
    }
  ]
}
